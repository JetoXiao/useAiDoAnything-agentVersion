# =============================================================================
# UseAiForMe Runtime Dockerfile
# =============================================================================
# Builds a runtime image from a prebuilt Linux amd64 binary.
# Useful for low-memory servers where compiling Go/Node inside Docker is slow.
# =============================================================================

ARG ALPINE_IMAGE=alpine:3.21
ARG POSTGRES_IMAGE=postgres:18-alpine

FROM ${POSTGRES_IMAGE} AS pg-client
FROM ${ALPINE_IMAGE}

LABEL maintainer="JetoXiao"
LABEL description="UseAiForMe - AI API Gateway Platform"
LABEL org.opencontainers.image.source="https://github.com/JetoXiao/useAiDoAnything-agentVersion"

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    su-exec \
    libpq \
    zstd-libs \
    lz4-libs \
    krb5-libs \
    libldap \
    libedit \
    wget \
    && rm -rf /var/cache/apk/*

COPY --from=pg-client /usr/local/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pg-client /usr/local/bin/psql /usr/local/bin/psql
COPY --from=pg-client /usr/local/lib/libpq.so.5* /usr/local/lib/

RUN addgroup -g 1000 sub2api && \
    adduser -u 1000 -G sub2api -s /bin/sh -D sub2api

WORKDIR /app

COPY --chown=sub2api:sub2api deploy/artifacts/sub2api /app/sub2api
COPY --chown=sub2api:sub2api backend/resources /app/resources

RUN mkdir -p /app/data && \
    chown sub2api:sub2api /app/data && \
    chmod +x /app/sub2api

COPY deploy/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://localhost:${SERVER_PORT:-8080}/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/sub2api"]
